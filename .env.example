# 复制为 .env 后填入真实 key。.env 已被 .gitignore 忽略，不会进 git。
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型（2026-11 文档：deepseek-flash / deepseek-v4-pro）
DEEPSEEK_MODEL_MIND=deepseek-flash
DEEPSEEK_MODEL_DM=deepseek-flash
DEEPSEEK_MODEL_NARRATOR=deepseek-flash

# 实验开关：DM 是否能看到角色能力值（默认 false，见 demos/embodied/DESIGN.md §5.4）
DM_SEES_CAPABILITY=false

# 默认世界种子（可被 CLI --seed 覆盖）
LW_SEED=42

# LLM 响应录制：off / record / replay（cassette 文件不含 headers，也不含 key）
LLM_CASSETTE=off
LLM_CASSETTE_DIR=.cassette
